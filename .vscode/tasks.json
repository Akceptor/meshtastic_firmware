{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "PlatformIO",
      "task": "Build",
      "problemMatcher": ["$platformio"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "PlatformIO: Build"
    },
    {
      "type": "PlatformIO",
      "task": "Build (emax_900_tx_oled)",
      "problemMatcher": ["$platformio"],
      "group": "build",
      "label": "PlatformIO: Build emax_900_tx_oled"
    },
    {
      "type": "PlatformIO",
      "task": "Upload (emax_900_tx_oled)",
      "problemMatcher": ["$platformio"],
      "group": "test",
      "label": "PlatformIO: Flash emax_900_tx_oled"
    },
    {
      "type": "PlatformIO",
      "task": "Build (bayckrc_dual_band)",
      "problemMatcher": ["$platformio"],
      "group": "build",
      "label": "PlatformIO: Build bayckrc_dual_band"
    },
    {
      "type": "shell",
      "label": "PlatformIO: Flash bayckrc_dual_band",
      "command": "cd ${workspaceFolder} && pio run -e bayckrc_dual_band -t upload --upload-port $(ls /dev/tty.usb* 2>/dev/null | head -1)",
      "problemMatcher": ["$platformio"],
      "group": "test"
    }
  ]
}
